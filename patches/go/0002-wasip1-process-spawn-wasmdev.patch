+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasip1
+
+package os
+
+import "syscall"
+
+// blockUntilWaitable blocks until a call to p.Wait will succeed
+// immediately, and reports whether it has done so.
+//
+// wasmdev patch: wasip1 programs are single-threaded, so a blocking
+// host wait would freeze every goroutine (including the ones copying
+// the child's output). Instead, read the child's exit fd until EOF
+// through the netpoller, which parks only this goroutine.
+func (p *Process) blockUntilWaitable() (bool, error) {
+	fd, ok := syscall.WasmdevTakeExitFD(p.Pid)
+	if !ok {
+		return false, nil
+	}
+	f := newFile(fd, "|exit", kindPipe, false)
+	var buf [16]byte
+	for {
+		n, err := f.Read(buf[:])
+		if err != nil || n == 0 {
+			break
+		}
+	}
+	f.Close()
+	return true, nil
+}
