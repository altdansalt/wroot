diff --git a/src/syscall/proc_wasmdev_wasip1.go b/src/syscall/proc_wasmdev_wasip1.go
new file mode 100644
index 0000000..0ee477d
--- /dev/null
+++ b/src/syscall/proc_wasmdev_wasip1.go
@@ -0,0 +1,197 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasip1
+
+// wasmdev patch: child processes on top of the wasmdev host's
+// "wasmdev_proc" imports (see wasmdev docs/HOST_CAPABILITIES.md).
+// A child is another wasm module run by the host; it inherits the
+// caller's preopens. spawn never blocks: it returns a pid and an
+// "exit fd" (a stream socket that reaches EOF when the child exits),
+// which package os waits on through the netpoller, so other goroutines
+// keep running while children run.
+
+package syscall
+
+import (
+	"sync"
+	"unsafe"
+)
+
+//go:wasmimport wasmdev_proc spawn
+//go:noescape
+func proc_spawn(path unsafe.Pointer, pathLen size, argv unsafe.Pointer, argvLen size, env unsafe.Pointer, envLen size, dir unsafe.Pointer, dirLen size, fd0, fd1, fd2 int32, pid unsafe.Pointer, exitfd unsafe.Pointer) Errno
+
+//go:wasmimport wasmdev_proc wait
+//go:noescape
+func proc_wait(pid int32, nohang int32, status unsafe.Pointer) Errno
+
+//go:wasmimport wasmdev_proc kill
+func proc_kill(pid int32, sig int32) Errno
+
+//go:wasmimport wasmdev_proc pipe
+//go:noescape
+func proc_pipe(fds unsafe.Pointer) Errno
+
+//go:wasmimport wasmdev_proc open_null
+//go:noescape
+func proc_open_null(write int32, fd unsafe.Pointer) Errno
+
+const WNOHANG = 0x1
+
+var (
+	exitFDsMu sync.Mutex
+	exitFDs   = map[int]int{}
+)
+
+// WasmdevTakeExitFD returns (and forgets) the exit fd of child pid.
+// The caller owns the fd. Used by package os.
+func WasmdevTakeExitFD(pid int) (fd int, ok bool) {
+	exitFDsMu.Lock()
+	defer exitFDsMu.Unlock()
+	fd, ok = exitFDs[pid]
+	delete(exitFDs, pid)
+	return
+}
+
+func nulJoin(ss []string) []byte {
+	n := 0
+	for _, s := range ss {
+		n += len(s) + 1
+	}
+	b := make([]byte, 0, n+1)
+	for _, s := range ss {
+		b = append(b, s...)
+		b = append(b, 0)
+	}
+	return b
+}
+
+func bytesPtr(b []byte) unsafe.Pointer {
+	if len(b) == 0 {
+		return nil
+	}
+	return unsafe.Pointer(&b[0])
+}
+
+func StartProcess(argv0 string, argv []string, attr *ProcAttr) (pid int, handle uintptr, err error) {
+	if attr == nil {
+		attr = &ProcAttr{}
+	}
+	if argv0 == "" {
+		return 0, 0, ENOENT
+	}
+	cwd, _ := Getwd()
+	dir := attr.Dir
+	if dir == "" {
+		dir = cwd
+	} else if dir[0] != '/' {
+		dir = joinPath(cwd, dir)
+	}
+	path := argv0
+	if path[0] != '/' {
+		// As with fork+chdir+exec: relative to the child's directory.
+		path = joinPath(dir, path)
+	}
+	fds := [3]int32{-1, -1, -1}
+	for i, f := range attr.Files {
+		if f == ^uintptr(0) {
+			continue
+		}
+		if i >= 3 {
+			return 0, 0, ENOSYS // no ExtraFiles
+		}
+		fds[i] = int32(f)
+	}
+	pathb := []byte(path)
+	dirb := []byte(dir)
+	argvb := nulJoin(argv)
+	envb := nulJoin(attr.Env)
+	var p, efd int32
+	errno := proc_spawn(bytesPtr(pathb), size(len(pathb)), bytesPtr(argvb), size(len(argvb)),
+		bytesPtr(envb), size(len(envb)), bytesPtr(dirb), size(len(dirb)),
+		fds[0], fds[1], fds[2], unsafe.Pointer(&p), unsafe.Pointer(&efd))
+	if errno != 0 {
+		return 0, 0, errno
+	}
+	exitFDsMu.Lock()
+	exitFDs[int(p)] = int(efd)
+	exitFDsMu.Unlock()
+	return int(p), 0, nil
+}
+
+// Wait4 reaps child pid. Without WNOHANG it blocks the whole program
+// (wasip1 is single-threaded); package os avoids that by first waiting
+// for EOF on the exit fd in the netpoller.
+func Wait4(pid int, wstatus *WaitStatus, options int, rusage *Rusage) (wpid int, err error) {
+	var nohang int32
+	if options&WNOHANG != 0 {
+		nohang = 1
+	}
+	var st int32
+	if errno := proc_wait(int32(pid), nohang, unsafe.Pointer(&st)); errno != 0 {
+		if errno == EAGAIN && nohang != 0 {
+			return 0, nil
+		}
+		return 0, errno
+	}
+	if fd, ok := WasmdevTakeExitFD(pid); ok {
+		Close(fd)
+	}
+	if wstatus != nil {
+		*wstatus = WaitStatus(st)
+	}
+	if rusage != nil {
+		*rusage = Rusage{}
+	}
+	return pid, nil
+}
+
+func Pipe(fd []int) error {
+	if len(fd) != 2 {
+		return EINVAL
+	}
+	var fds [2]int32
+	if errno := proc_pipe(unsafe.Pointer(&fds)); errno != 0 {
+		return errno
+	}
+	fd[0], fd[1] = int(fds[0]), int(fds[1])
+	return nil
+}
+
+func openDevNull(openmode int) (int, error) {
+	var write int32
+	if openmode&(O_WRONLY|O_RDWR) != 0 {
+		write = 1
+	}
+	var fd int32
+	if errno := proc_open_null(write, unsafe.Pointer(&fd)); errno != 0 {
+		return -1, errno
+	}
+	return int(fd), nil
+}
+
+// Unix-style wait status: exit code in bits 8-15, terminating signal
+// in bits 0-6.
+type WaitStatus uint32
+
+func (w WaitStatus) Exited() bool { return w&0x7f == 0 }
+func (w WaitStatus) ExitStatus() int {
+	if !w.Exited() {
+		return -1
+	}
+	return int(w>>8) & 0xff
+}
+func (w WaitStatus) Signaled() bool { return w&0x7f != 0 }
+func (w WaitStatus) Signal() Signal {
+	if !w.Signaled() {
+		return 0
+	}
+	return Signal(w & 0x7f)
+}
+func (w WaitStatus) CoreDump() bool     { return false }
+func (w WaitStatus) Stopped() bool      { return false }
+func (w WaitStatus) Continued() bool    { return false }
+func (w WaitStatus) StopSignal() Signal { return 0 }
+func (w WaitStatus) TrapCause() int     { return -1 }
