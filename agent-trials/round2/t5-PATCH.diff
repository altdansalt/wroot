diff -ruN control.original/pipeline.go control/pipeline.go
--- control.original/pipeline.go	1970-01-01 00:00:00.000000000 +0000
+++ control/pipeline.go	2026-10-15 17:44:27.061834699 +0000
@@ -0,0 +1,137 @@
+package main
+
+import (
+	"io"
+	"os"
+	"sync"
+	"time"
+)
+
+// Keep redirections on the established sequential path: their filesystem
+// side effects and ordered 2>&1 bindings must not race other stages.
+func streamable(pl pipeline) bool {
+	if len(pl.Cmds) < 2 {
+		return false
+	}
+	for _, c := range pl.Cmds {
+		if len(c.Words) == 0 || len(c.Redirs) != 0 || !isBuiltin(unmark(c.Words[0])) {
+			return false
+		}
+	}
+	return true
+}
+
+type streamStage func(io.Reader, io.Writer) int
+
+// pipeStages owns every pipe endpoint. Closing a consumer's reader wakes
+// blocked producers with ErrClosedPipe; closing a producer delivers EOF.
+// io.Pipe has no intermediate buffer and therefore provides backpressure.
+// Endpoints supplied by the caller are borrowed, never closed here.
+func pipeStages(stages []streamStage, input io.Reader, output io.Writer, stop <-chan struct{}) ([]int, error) {
+	readers := make([]*io.PipeReader, len(stages)-1)
+	writers := make([]*io.PipeWriter, len(readers))
+	for i := range readers {
+		readers[i], writers[i] = io.Pipe()
+	}
+	closePipes := func(err error) {
+		for i := range readers {
+			readers[i].CloseWithError(err)
+			writers[i].CloseWithError(err)
+		}
+	}
+	finished, watched := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(watched)
+		select {
+		case <-stop:
+			closePipes(errStop)
+		case <-finished:
+		}
+	}()
+	statuses := make([]int, len(stages))
+	var wg sync.WaitGroup
+	for i, stage := range stages {
+		wg.Add(1)
+		go func(i int, stage streamStage) {
+			defer wg.Done()
+			in, out := input, output
+			if i > 0 {
+				in = readers[i-1]
+				defer readers[i-1].Close()
+			}
+			if i < len(writers) {
+				out = writers[i]
+				defer writers[i].Close()
+			}
+			statuses[i] = stage(in, out)
+		}(i, stage)
+	}
+	wg.Wait()
+	close(finished)
+	<-watched
+	closePipes(nil)
+	select {
+	case <-stop:
+		return statuses, errStop
+	default:
+		return statuses, nil
+	}
+}
+
+func (rc *runCtx) runBuiltinPipeline(pl pipeline) (int, error) {
+	// Independent contexts prevent races in command-local IO and failure state.
+	// Collect steps by stage index so the public result remains deterministic.
+	steps := make([]stepResult, len(pl.Cmds))
+	stages := make([]streamStage, len(pl.Cmds))
+	for i, c := range pl.Cmds {
+		argv := expandGlobs(rc.j.Workspace, c.Words)
+		stages[i] = func(in io.Reader, out io.Writer) int {
+			child := &runCtx{s: rc.s, j: rc.j, req: rc.req, input: in, output: out}
+			start := time.Now()
+			status := builtins[argv[0]](child, argv[1:])
+			if child.writeErr != nil {
+				status = 1
+			}
+			kind := "builtin"
+			steps[i] = stepResult{Argv: argv, Kind: &kind, State: "exited", ExitCode: intp(status), WallMs: msSince(start)}
+			return status
+		}
+	}
+	out, err := os.OpenFile(rc.stdoutPath(), os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0o644)
+	if err != nil {
+		return 1, err
+	}
+	defer out.Close()
+	stop, finished, watched := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(watched)
+		ticker := time.NewTicker(5 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			rc.j.mu.Lock()
+			cancelled := rc.j.killed || (!rc.j.deadline.IsZero() && !time.Now().Before(rc.j.deadline))
+			rc.j.mu.Unlock()
+			if cancelled {
+				close(stop)
+				return
+			}
+			select {
+			case <-finished:
+				return
+			case <-ticker.C:
+			}
+		}
+	}()
+	statuses, err := pipeStages(stages, rc.input, out, stop)
+	close(finished)
+	<-watched
+	rc.j.mu.Lock()
+	rc.j.steps = append(rc.j.steps, steps...)
+	expired := !rc.j.deadline.IsZero() && !time.Now().Before(rc.j.deadline)
+	rc.j.mu.Unlock()
+	if expired {
+		rc.abn = &stepResult{State: "timeout", Error: strp("timeout")}
+		err = errStop
+	}
+	return statuses[len(statuses)-1], err
+}
diff -ruN control.original/pipeline_test.go control/pipeline_test.go
--- control.original/pipeline_test.go	1970-01-01 00:00:00.000000000 +0000
+++ control/pipeline_test.go	2026-10-15 17:44:45.653547114 +0000
@@ -0,0 +1,199 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestStreamable(t *testing.T) {
+	for _, tc := range []struct {
+		cmd  string
+		want bool
+	}{
+		{"echo hi | cat | cat", true}, {"false | true", true},
+		{"echo hi", false}, {"echo hi | tool", false},
+		{"echo hi > out | cat", false}, {"echo hi | cat < in", false},
+		{"echo hi 2>&1 | cat", false},
+	} {
+		l, err := parseCmd(tc.cmd)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := streamable(l.Pipes[0]); got != tc.want {
+			t.Errorf("%s: %v", tc.cmd, got)
+		}
+	}
+}
+
+func TestPipeEarlyConsumer(t *testing.T) {
+	// An unbounded producer must stop as soon as its consumer closes stdin.
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		var out bytes.Buffer
+		stages := []streamStage{
+			func(_ io.Reader, w io.Writer) int {
+				for {
+					if _, err := io.WriteString(w, "yes\n"); err != nil {
+						return 1
+					}
+				}
+			},
+			func(r io.Reader, w io.Writer) int {
+				_, err := io.CopyN(w, r, 12)
+				if err != nil {
+					return 1
+				}
+				return 0
+			},
+		}
+		statuses, err := pipeStages(stages, nil, &out, nil)
+		if err != nil || statuses[0] != 1 || statuses[1] != 0 || out.String() != "yes\nyes\nyes\n" {
+			t.Errorf("statuses=%v err=%v output=%q", statuses, err, out.String())
+		}
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("producer failed to stop")
+	}
+}
+
+func TestPipeCancellation(t *testing.T) {
+	stop := make(chan struct{})
+	started := make(chan struct{})
+	stages := []streamStage{
+		func(_ io.Reader, w io.Writer) int {
+			close(started)
+			for {
+				if _, err := w.Write([]byte("x")); err != nil {
+					return 1
+				}
+			}
+		},
+		func(r io.Reader, _ io.Writer) int {
+			_, err := io.Copy(io.Discard, r)
+			if err != nil {
+				return 1
+			}
+			return 0
+		},
+	}
+	go func() { <-started; close(stop) }()
+	if _, err := pipeStages(stages, nil, io.Discard, stop); err != errStop {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestPipeBackpressure(t *testing.T) {
+	produced := make(chan struct{})
+	stop := make(chan struct{})
+	stages := []streamStage{
+		func(_ io.Reader, w io.Writer) int { w.Write([]byte("x")); close(produced); return 0 },
+		func(r io.Reader, _ io.Writer) int {
+			select {
+			case <-produced:
+				t.Error("write completed before read")
+			default:
+			}
+			b := make([]byte, 1)
+			_, err := io.ReadFull(r, b)
+			if err != nil {
+				return 1
+			}
+			return 0
+		},
+	}
+	statuses, err := pipeStages(stages, nil, io.Discard, stop)
+	if err != nil || statuses[1] != 0 {
+		t.Fatalf("%v %v", statuses, err)
+	}
+}
+
+func TestBuiltinPipeline(t *testing.T) {
+	for _, tc := range []struct {
+		cmd, stdin, want string
+		status           int
+	}{
+		{"echo hello | cat | cat", "", "hello\n", 0},
+		{"cat | cat", "request input\n", "request input\n", 0},
+		{"false | true", "", "", 0}, {"true | false", "", "", 1},
+		{"echo ignored | true | cat", "", "", 0},
+	} {
+		t.Run(tc.cmd, func(t *testing.T) {
+			dir := t.TempDir()
+			if err := os.WriteFile(dir+"/stdin", []byte(tc.stdin), 0600); err != nil {
+				t.Fatal(err)
+			}
+			rc := &runCtx{j: &job{dir: dir}, req: &runRequest{Stdin: tc.stdin}}
+			l, _ := parseCmd(tc.cmd)
+			st, err := rc.runBuiltinPipeline(l.Pipes[0])
+			b, readErr := os.ReadFile(dir + "/stdout")
+			if err != nil || readErr != nil || st != tc.status || string(b) != tc.want {
+				t.Fatalf("status=%d err=%v read=%v output=%q", st, err, readErr, b)
+			}
+			if len(rc.j.steps) != len(l.Pipes[0].Cmds) {
+				t.Fatal("missing steps")
+			}
+			for i, step := range rc.j.steps {
+				if step.Argv[0] != l.Pipes[0].Cmds[i].Words[0] {
+					t.Fatal("steps reordered")
+				}
+			}
+		})
+	}
+}
+
+func TestCatLargeInputAndWriteError(t *testing.T) {
+	input := strings.Repeat("abcdefgh", 1<<18)
+	rc := &runCtx{j: &job{dir: t.TempDir()}, req: &runRequest{}, input: strings.NewReader(input), output: io.Discard}
+	if st := builtinCat(rc, nil); st != 0 {
+		t.Fatalf("cat status %d", st)
+	}
+	r, w := io.Pipe()
+	r.Close()
+	rc.input, rc.output = strings.NewReader("hello"), w
+	if st := builtinCat(rc, nil); st != 1 {
+		t.Fatalf("broken pipe status %d", st)
+	}
+	w.Close()
+}
+
+func TestBuiltinPipelineCancelledJob(t *testing.T) {
+	for _, killed := range []bool{false, true} {
+		j := &job{dir: t.TempDir(), killed: killed}
+		if !killed {
+			j.deadline = time.Now().Add(-time.Second)
+		}
+		rc := &runCtx{j: j, req: &runRequest{}}
+		l, _ := parseCmd("echo hi | cat")
+		_, err := rc.runBuiltinPipeline(l.Pipes[0])
+		if !killed && (err != errStop || rc.abn == nil || rc.abn.State != "timeout") {
+			t.Fatalf("timeout: %v %+v", err, rc.abn)
+		}
+		// drive gives the job's killed flag precedence over stage results.
+		if killed && !j.killed {
+			t.Fatal("lost killed flag")
+		}
+	}
+}
+
+func TestCatRejectsSelfAppend(t *testing.T) {
+	dir := t.TempDir()
+	p := dir + "/same"
+	if err := os.WriteFile(p, []byte("initial"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	rc := &runCtx{j: &job{dir: dir}, req: &runRequest{}, io: cmdIO{stdin: p, stdout: p}}
+	if st := builtinCat(rc, nil); st != 1 {
+		t.Fatalf("self append status %d", st)
+	}
+	b, err := os.ReadFile(p)
+	if err != nil || string(b) != "initial" {
+		t.Fatalf("%q %v", b, err)
+	}
+}
